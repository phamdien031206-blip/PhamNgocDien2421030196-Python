a = int(input("Nhập a = "))
b = int(input("Nhập b = "))
c = int(input("Nhập c = "))

tong = a + b + c
print("Tổng =", tong)

# Đếm số chữ số chẵn
dem = 0
tam = tong

while tam > 0:
    chu_so = tam % 10
    
    if chu_so % 2 == 0:
        dem += 1
        
    tam = tam // 10

print("Số chữ số chẵn trong tổng là:", dem)