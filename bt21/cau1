#include <stdio.h>

int main() {
    int n, i, dem = 0;
    float x[100], tong = 0, tbc;

    printf("Nhap n: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        printf("x[%d] = ", i);
        scanf("%f", &x[i]);

        if(x[i] > 0 && x[i] < 1000) {
            tong += x[i];
            dem++;
        }
    }

    if(dem > 0) {
        tbc = tong / dem;
        printf("Trung binh cong = %.2f", tbc);
    } else {
        printf("Khong co phan tu hop le");
    }

    return 0;
}