#include <stdio.h>

int main() {
    int a, b, tong, max = 0, temp, so;

    printf("Nhap a va b: ");
    scanf("%d%d", &a, &b);

    tong = a + b;
    temp = tong;

    while(temp > 0) {
        so = temp % 10;

        if(so > max)
            max = so;

        temp /= 10;
    }

    printf("Tong = %d\n", tong);
    printf("Chu so lon nhat = %d", max);

    return 0;
}